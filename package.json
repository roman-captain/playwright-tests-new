{
  "name": "playwright-tests-new",
  "version": "1.0.0",
  "description": "Playwright E2E test suite — Valtive Wiki standard",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:a11y": "playwright test --grep @a11y",
    "test:contract": "playwright test --grep @contract",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:generate": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "axe-playwright": "^2.2.2",
    "dotenv": "^16.0.0",
    "playwright-qase-reporter": "^2.5.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "langfuse": "^3.38.20"
  }
}
